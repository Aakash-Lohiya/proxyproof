# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890

# Local development against the Firebase emulators (firebase/ folder: npm run emulators).
# EXPO_PUBLIC_FIREBASE_EMULATOR=1
# On a physical phone, the emulator host is your computer's LAN IP:
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.10
